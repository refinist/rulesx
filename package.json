{
  "name": "rulesx",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "description": "Minimal CLI to install .mdc rules from git repos into .cursor/rules/",
  "author": "REFINIST",
  "license": "MIT",
  "homepage": "https://github.com/refinist/rulesx",
  "repository": {
    "type": "git",
    "url": "https://github.com/refinist/rulesx.git"
  },
  "bugs": {
    "url": "https://github.com/refinist/rulesx/issues"
  },
  "keywords": [
    "rules",
    "cursor",
    "mdc",
    "ai",
    "agent",
    "cli",
    "cursor-rules",
    "agents-md",
    "claude",
    "copilot",
    "windsurf",
    "cline"
  ],
  "bin": {
    "rulesx": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write --cache .",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "minimatch": "^10.2.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@refinist/eslint-config": "^1.3.0",
    "@refinist/prettier-config": "^1.2.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260322.1",
    "@vitest/coverage-v8": "4.1.0",
    "bumpp": "^11.0.1",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "prettier": "@refinist/prettier-config"
}
